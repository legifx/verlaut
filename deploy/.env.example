# Verlaut — Beispielkonfiguration. KEINE echten Werte committen.
# Kopieren: cp deploy/.env.example deploy/.env  und Werte setzen.

# Öffentliche Domain (oder Tailscale-MagicDNS-Name) für Caddy/Auto-TLS.
VERLAUT_DOMAIN=verlaut.example.com

# Muss zur clientseitigen Origin passen (CORS + WS-Origin-Check, strikt).
VERLAUT_ALLOWED_ORIGIN=https://verlaut.example.com

# Postgres-Passwort (stark, zufällig).
POSTGRES_PASSWORD=change-me-strong-random

# Öffentliche ntfy-URL (falls extern erreichbar; sonst interner Wert ok).
NTFY_PUBLIC_URL=https://verlaut.example.com

# Optional: max. Envelope-Größe (Bytes). Für Bilder/Sprachnachrichten anheben
# (z. B. 2 MB). Standard 65536.
VERLAUT_MAX_ENVELOPE_BYTES=2097152

# Optional: öffentliches Nutzerverzeichnis (GET /v1/directory). true = alle
# Nutzer sehen einander (praktisch für kleine private Runden). Achtung: gibt die
# komplette Username-Liste an jeden Tailnet-Client heraus. false = Endpoint 404.
VERLAUT_DIRECTORY_ENABLED=true
